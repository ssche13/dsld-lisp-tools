<?xml version="1.0" encoding="utf-8"?>
<!--
  Autoloader manifest for the DSLD LISP tools (RPR / SCH / ADIM).

  Deployment on a drafter's machine is a FOLDER COPY - no admin rights,
  no registry editing, no APPLOAD:

      %APPDATA%\Autodesk\ApplicationPlugins\DSLD-Tools.bundle\
          PackageContents.xml
          Contents\DSLD-Loader.lsp   (+ the three routine .lsp files)

  AutoCAD scans ApplicationPlugins at startup and loads the LISP module
  below into every drawing, exactly like the Startup Suite.  Platform
  values match the Autodesk-shipped bundles on this machine (ADT =
  AutoCAD Architecture).  SERIES RANGE MATTERS: office seats run BOTH
  ACA 2026 (R25.1) and 2027 (R26.0) - SeriesMin must stay at or below
  R25.0 or the AutoLoader silently skips the whole package on 2026
  seats (that outage looked exactly like "nothing loads after
  restart").  SeriesMax is set high so future upgrades keep loading.
-->
<ApplicationPackage
  SchemaVersion="1.0"
  AppVersion="1.1.4"
  Author="DSLD"
  Name="DSLD Tools"
  Description="DSLD LISP tools: RPR roof pitch + rafters, SCH schedule of openings, ADIM auto-dimension"
  ProductCode="{a946de65-690c-499f-a6b8-75e0d57b1a78}"
  UpgradeCode="{27f7300e-326d-479f-be8a-8d63035500f2}"
  >
  <CompanyDetails Name="DSLD" Url="" Email="" />

  <RuntimeRequirements
      Platform="AutoCAD|ADT"
      SeriesMin="R25.0"
      SeriesMax="R30.0"
      OS="Win64"
      SupportPath="./Contents" />

  <!-- ONE component on purpose.  The loader is the only file the
       AutoLoader ever references; it loads the LISP routines and
       NETLOADs SchTagNet.dll itself when the DLL is present.  A
       manifest that names optional payloads directly can take the
       whole package down when one is missing (e.g. a machine
       installed by the pre-1.1 email installer, which fetched no
       binaries) - the AutoLoader skips the bundle silently and
       NOTHING loads after a restart. -->
  <Components>
    <ComponentEntry
        AppName="DSLDTools"
        ModuleName="./Contents/DSLD-Loader.lsp"
        AppDescription="Loads the DSLD RPR / SCH / ADIM LISP tools in every drawing"
        LoadOnAutoCADStartup="True" />
  </Components>

  <DisplayInAppManager>false</DisplayInAppManager>
</ApplicationPackage>
